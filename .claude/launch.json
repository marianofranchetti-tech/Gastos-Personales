{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--offline"],
      "port": 8081
    },
    {
      "name": "expo-web-local",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set EXPO_NO_DOTENV=1&& npx expo start --web --offline --clear --port 8082"],
      "port": 8082
    },
    {
      "name": "bello-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "http-server", "C:/Users/Administrador/Desktop/bello-export-web", "-p", "4599", "-c-1"],
      "port": 4599
    }
  ]
}
