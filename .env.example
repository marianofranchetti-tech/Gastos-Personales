# Copiá este archivo a .env.local y completá con los datos de tu proyecto de
# Supabase (Project Settings > API). Ver SUPABASE.md.
#
# Sin estas variables la app funciona solo en el dispositivo, sin cuentas.
# La clave "anon" (publishable) es pública por diseño: va dentro de la app.
# NUNCA pongas acá la service_role: esa saltea toda la seguridad.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
